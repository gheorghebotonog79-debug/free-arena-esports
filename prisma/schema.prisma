generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String          @unique
  avatar        String?
  role          String          @default("helper")
  passwordHash  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean         @default(true)
  adminRole     AdminRole       @relation(fields: [role], references: [name], onUpdate: Cascade)
  auditLogs     AdminAuditLog[]
  adminSessions AdminSession[]
  newsPosts     NewsPost[]
  playerProfile PlayerProfile?

  @@index([role])
  @@index([isActive])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([priority])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action])
  @@index([target])
  @@index([createdAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model NewsPost {
  id          String    @id @default(cuid())
  slug        String
  locale      String
  title       String
  excerpt     String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([locale, slug])
  @@index([published, publishedAt])
  @@index([createdBy])
}

model GameServer {
  id           String   @id @default(cuid())
  name         String
  game         String
  host         String
  port         Int
  featured     Boolean  @default(false)
  maintenance  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([host, port])
  @@index([game])
  @@index([featured, displayOrder])
  @@index([maintenance])
}

model Tournament {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  game        String
  status      String    @default("draft")
  startsAt    DateTime?
  endsAt      DateTime?
  prizePool   String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([game])
  @@index([status, startsAt])
}

model VipPackage {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @default(0) @db.Decimal(10, 2)
  enabled      Boolean  @default(true)
  perks        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
}

model PlayerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  steamId    String?  @unique
  discordId  String?  @unique
  nickname   String?
  rank       String?
  reputation Int      @default(0)
  bansCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rank])
  @@index([reputation])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
