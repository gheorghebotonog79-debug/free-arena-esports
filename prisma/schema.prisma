generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String          @unique
  avatar        String?
  role          String          @default("helper")
  passwordHash  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean         @default(true)
  adminRole     AdminRole       @relation(fields: [role], references: [name], onUpdate: Cascade)
  auditLogs     AdminAuditLog[]
  adminSessions AdminSession[]
  newsPosts     NewsPost[]
  playerProfile PlayerProfile?

  @@index([role])
  @@index([isActive])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([priority])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action])
  @@index([target])
  @@index([createdAt])
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model NewsPost {
  id          String    @id @default(cuid())
  slug        String
  locale      String
  title       String
  excerpt     String
  content     String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([locale, slug])
  @@index([published, publishedAt])
  @@index([createdBy])
}

model GameServer {
  id           String   @id @default(cuid())
  name         String
  game         String
  host         String
  port         Int
  featured     Boolean  @default(false)
  maintenance  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([host, port])
  @@index([game])
  @@index([featured, displayOrder])
  @@index([maintenance])
}

model Tournament {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  game        String
  status      String    @default("draft")
  startsAt    DateTime?
  endsAt      DateTime?
  prizePool   String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([game])
  @@index([status, startsAt])
}

model VipPackage {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @default(0) @db.Decimal(10, 2)
  enabled      Boolean  @default(true)
  perks        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
}

model PlayerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  steamId    String?  @unique
  discordId  String?  @unique
  nickname   String?
  rank       String?
  reputation Int      @default(0)
  bansCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rank])
  @@index([reputation])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminMonitorAdmin {
  id          String   @id @default(cuid())
  steamId     String   @unique
  currentName String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastSeenAt])
}

model AdminMonitorSession {
  id              String    @id @default(cuid())
  serverKey       String
  adminSteamId    String
  adminName       String
  startedAt       DateTime
  lastHeartbeatAt DateTime
  endedAt         DateTime?
  minutesOnline   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([serverKey, adminSteamId, lastHeartbeatAt])
  @@index([endedAt])
}

model AdminMonitorEvent {
  id            String   @id @default(cuid())
  serverKey     String
  eventType     String
  adminSteamId  String
  adminName     String
  targetSteamId String?
  targetName    String?
  command       String?
  metadata      Json     @default("{}")
  occurredAt    DateTime
  createdAt     DateTime @default(now())

  @@index([serverKey, occurredAt])
  @@index([adminSteamId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([targetSteamId])
}

model AdminMonitorRecruit {
  id                String    @id @default(cuid())
  serverKey         String
  adminSteamId      String
  adminName         String
  targetSteamId     String
  targetName        String
  status            String    @default("pending")
  reportedAt        DateTime
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  initialPlayedTime Int?
  currentPlayedTime Int?
  requiredMinutes   Int       @default(60)
  windowDays        Int       @default(7)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([serverKey, targetSteamId])
  @@index([serverKey, status, reportedAt])
  @@index([adminSteamId, reportedAt])
}

model AdminMonitorDailyScore {
  id              String   @id @default(cuid())
  serverKey       String
  adminSteamId    String
  date            DateTime @db.Date
  minutesOnline   Int      @default(0)
  activeDayPoints Int      @default(0)
  timePoints      Int      @default(0)
  actionPoints    Int      @default(0)
  recruitPoints   Int      @default(0)
  penaltyPoints   Int      @default(0)
  totalPoints     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serverKey, adminSteamId, date])
  @@index([date])
  @@index([adminSteamId, date])
}

model AdminMonitorMonthlyReport {
  id               String   @id @default(cuid())
  serverKey        String
  month            String   @db.VarChar(6)
  adminSteamId     String
  minutesOnline    Int      @default(0)
  activeDays       Int      @default(0)
  actionsCount     Int      @default(0)
  recruitsAccepted Int      @default(0)
  penalties        Int      @default(0)
  totalPoints      Int      @default(0)
  rewardTier       String?
  upgradeEligible  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([serverKey, adminSteamId, month])
  @@index([month, totalPoints])
  @@index([adminSteamId, month])
}

model AdminMonitorPenalty {
  id           String   @id @default(cuid())
  serverKey    String
  adminSteamId String
  points       Int
  reason       String
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([serverKey, adminSteamId, createdAt])
}

model AdminMonitorReward {
  id           String   @id @default(cuid())
  serverKey    String
  adminSteamId String
  month        String   @db.VarChar(6)
  tier         String
  status       String   @default("pending")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([serverKey, adminSteamId, month])
  @@index([status, month])
}

model ForumVipCode {
  id               String    @id @default(cuid())
  code             String    @unique
  serverKey        String
  steamId          String
  nickname         String
  ipHash           String?
  subnetHash       String?
  status           String    @default("issued")
  reason           String?
  forumUserId      Int?
  forumUsername    String?
  approvedPosts    Int?
  firstPostId      Int?
  firstPostTopicId Int?
  firstPostForumId Int?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  verifiedAt       DateTime?
  redeemedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([serverKey, steamId, status])
  @@index([expiresAt])
  @@index([forumUserId])
  @@index([ipHash])
  @@index([subnetHash])
}

model ForumVipReward {
  id            String   @id @default(cuid())
  serverKey     String
  steamId       String   @unique
  forumUserId   Int      @unique
  forumUsername String
  code          String   @unique
  rewardType    String   @default("vip_diamond")
  flags         String   @default("tx")
  status        String   @default("active")
  ipHash        String?
  subnetHash    String?
  startsAt      DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serverKey, status, expiresAt])
  @@index([expiresAt])
  @@index([ipHash])
  @@index([subnetHash])
}
